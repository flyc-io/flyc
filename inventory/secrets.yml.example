# Copier en inventory/secrets.yml (ignoré par git) et passer avec -e @inventory/secrets.yml.
# Chiffrable avec `ansible-vault encrypt inventory/secrets.yml`.
# Si absent, les secrets sont générés sur l'hôte data au premier run et relus ensuite.
# Les clés surchargent celles de /opt/flyc/secrets.env sur l'hôte data.
flyc_secrets_override: {}
#  DATAPLANE_PASSWORD: "..."
#  REDIS_PASSWORD: "..."
#  INTERNAL_TOKEN: "..."
#  POSTGRES_PASSWORD: "..."
#  FLYC_MASTER_KEY: "..."     # 32 octets en base64
