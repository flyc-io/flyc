# {{ ansible_managed }} — routage des alertes.
global:
  resolve_timeout: 5m
route:
  receiver: default
  group_by: [alertname, room, fqdn, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: default
{% if flyc_alert_webhook_url | default('') %}
    webhook_configs:
      - url: "{{ flyc_alert_webhook_url }}"
        send_resolved: true
{% else %}
    # Aucun récepteur configuré : renseigner flyc_alert_webhook_url dans l'inventaire (webhook, ou passerelle Telegram/mail).
{% endif %}
