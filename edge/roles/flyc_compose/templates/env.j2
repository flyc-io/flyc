# {{ ansible_managed }}
COMPOSE_PROJECT_NAME={{ flyc_compose_project }}
FLYC_ENV={{ flyc_env }}
FLYC_IMAGE_QUEUE={{ flyc_image_queue }}
FLYC_IMAGE_CONTROL={{ flyc_image_control }}
FLYC_IMAGE_RUNNER={{ flyc_image_runner }}
FLYC_DATA_DIR={{ flyc_data_dir }}

# Réseau
QUEUE_HOST_IP={{ mgmt_ip }}
ANNOUNCE_IP={{ mgmt_ip }}
QUEUE_PORT={{ flyc_queue_port }}
CONTROL_PORT={{ flyc_control_port }}
CONTROL_URL=http://{{ hostvars[groups['data'][0]].mgmt_ip }}:{{ flyc_control_port }}
REDIS_PORT_A={{ flyc_redis_ports[0] }}
REDIS_PORT_B={{ flyc_redis_ports[1] }}
REDIS_ADDRS={% for h in groups['queue'] %}{% for p in flyc_redis_node_ports %}{{ hostvars[h].mgmt_ip }}:{{ p }}{% if not loop.last %},{% endif %}{% endfor %}{% if not loop.last %},{% endif %}{% endfor %}

POSTGRES_PORT={{ flyc_postgres_port }}

# Plateforme
# La topologie (LB, hôtes de file) n'est plus ici : elle vit en base et s'amorce depuis
# inventory-seed.json, écrit à côté de ce fichier.
FLYC_WAIT_HOST={{ flyc_wait_host }}
FLYC_CONTROL_HOST={{ flyc_control_host }}
FLYC_ACME_EMAIL={{ flyc_acme_email | default('') }}
FLYC_ACME_DIRECTORY={{ flyc_acme_directory | default('') }}
FLYC_PUBLIC_URL={{ flyc_control_public_url | default('https://' ~ flyc_control_host) }}
FLYC_OIDC_ISSUER={{ flyc_oidc.issuer | default('') }}
FLYC_OIDC_CLIENT_ID={{ flyc_oidc.client_id | default('') }}
FLYC_OIDC_CLIENT_SECRET={{ flyc_oidc.client_secret | default('') }}
FLYC_OIDC_ADMIN_EMAILS={{ flyc_oidc.admin_emails | default('') }}
FLYC_COOKIE_SECURE={{ flyc_cookie_secure | default(true) | lower }}

# Secrets (générés sur l'hôte data au premier run)
REDIS_PASSWORD={{ flyc_secrets.REDIS_PASSWORD }}
INTERNAL_TOKEN={{ flyc_secrets.INTERNAL_TOKEN }}
POSTGRES_PASSWORD={{ flyc_secrets.POSTGRES_PASSWORD }}
FLYC_MASTER_KEY={{ flyc_secrets.FLYC_MASTER_KEY }}
GRAFANA_PASSWORD={{ flyc_secrets.GRAFANA_PASSWORD | default('') }}
GRAFANA_PORT={{ flyc_grafana_port | default(3000) }}
GRAFANA_ROOT_URL={{ flyc_grafana_root_url | default('http://' ~ mgmt_ip ~ ':' ~ (flyc_grafana_port | default(3000))) }}
ALERT_WEBHOOK_URL={{ flyc_alert_webhook_url | default('') }}
DATAPLANE_USER={{ dataplane_user }}
DATAPLANE_PASSWORD={{ flyc_secrets.DATAPLANE_PASSWORD }}
