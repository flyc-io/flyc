{
 "uid": "flyc-platform",
 "title": "Flyc · plateforme",
 "tags": [
  "flyc"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Visiteurs en attente",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(flyc_queue_pending)",
     "legendFormat": "classés"
    },
    {
     "refId": "B",
     "expr": "sum(flyc_queue_active)",
     "legendFormat": "pass actifs"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Flux SSE ouverts",
   "gridPos": {
