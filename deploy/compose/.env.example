# Généré par Ansible (edge/roles/flyc_compose/templates/env.j2). Exemple pour un run manuel all-in-one.
COMPOSE_PROJECT_NAME=flyc
FLYC_ENV=single
FLYC_IMAGE_QUEUE=ghcr.io/flyc-io/flyc-queue:latest
FLYC_IMAGE_CONTROL=ghcr.io/flyc-io/flyc-control:latest
FLYC_IMAGE_RUNNER=ghcr.io/flyc-io/flyc-runner:latest
FLYC_DATA_DIR=/var/lib/flyc
ANNOUNCE_IP=127.0.0.1
QUEUE_HOST_IP=127.0.0.1
QUEUE_PORT=8080
CONTROL_PORT=8090
CONTROL_URL=http://127.0.0.1:8090
REDIS_PORT_A=7000
REDIS_PORT_B=7001
REDIS_ADDRS=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003,127.0.0.1:7004,127.0.0.1:7005
POSTGRES_PORT=5432
FLYC_WAIT_HOST=wait.example.com
FLYC_CONTROL_HOST=control.example.com
# Topologie : lue en base par flyc-control, amorcée au premier démarrage par inventory-seed.json
# (à créer à côté de ce fichier, voir inventory-seed.example.json). Ne pas mettre ce JSON ici : le
# parseur dotenv de compose perdrait toutes les variables suivantes.
REDIS_PASSWORD=change-me
INTERNAL_TOKEN=change-me
POSTGRES_PASSWORD=change-me
FLYC_MASTER_KEY=change-me-32-bytes-base64
DATAPLANE_USER=flyc
DATAPLANE_PASSWORD=change-me
